{
  "name": "storyboarder",
  "productName": "Storyboarder",
  "version": "3.0.0",
  "description": "The fastest way to storyboard.",
  "main": "src/js/main.js",
  "scripts": {
    "start:language-preferences": "vite build --watch --config configs/language-preferences/vite.config.js",
    "start:print-project": "vite build --watch --config configs/print-project/vite.config.js",
    "start:electron": "cross-env NODE_ENV=development electron .",
    "start": "npm-run-all --parallel start:*",
    "dist:mac": "npm run build && electron-builder build -m --arm64 --x64",
    "dist:win": "npm run build && electron-builder build -w",
    "dist:linux": "npm run build && electron-builder build -l",
    "dist": "npm run build && build -mwl",
    "test": "node scripts/run-tests.js",
    "clean:fixtures": "git checkout test/fixtures && git clean test/fixtures -f",
    "prefs": "echo ~/Library/Application\\\\ Support/Storyboarder/pref.json",
    "prefs:reveal": "open ~/Library/Application\\ Support/Storyboarder",
    "postinstall": "",
    "build-thumbnails": "electron test/views/thumbnail-renderer/main.js",
    "build:language-preferences": "vite build --config configs/language-preferences/vite.config.js",
    "build:print-project": "vite build --config configs/print-project/vite.config.js",
    "build": "npm-run-all build:*",
    "deploy:prod": "node ./scripts/deploy.js",
    "lint": "eslint src/js/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qian2501/storyboarder.git"
  },
  "keywords": [
    "fountain",
    "storyboard",
    "storyboarder"
  ],
  "author": {
    "email": "qian2501@gmail.com",
    "name": "Qian2501"
  },
  "build": {
    "beforeBuild": "scripts/electron-builder-before-build.js",
    "afterSign": "scripts/notarize.js",
    "asar": true,
    "appId": "com.qian2501.storyboarder",
    "buildDependenciesFromSource": true,
    "compression": "maximum",
    "files": [
      "!*.md",
      "!DEVELOPERS.md",
      "!README.md",
      "!notes",
      "!test",
      "!.cache",
      "!.github",
      "!.vscode",
      "!dist",
      "!scripts"
    ],
    "mac": {
      "icon": "build/icon.icns",
      "hardenedRuntime": true,
      "category": "public.app-category.graphics-design",
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "gatekeeperAssess": false
    },
    "win": {
      "icon": "build/icon.ico"
    },
    "dmg": {
      "sign": false,
      "background": "build/background.png",
      "icon": "build/icon.icns",
      "iconSize": 160,
      "window": {
        "width": 675,
        "height": 500
      },
      "contents": [
        {
          "x": 177,
          "y": 335
        },
        {
          "x": 505,
          "y": 335,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "linux": {
      "target": [
        "rpm",
        "deb",
        "AppImage"
      ],
      "icon": "build/icon.icns",
      "synopsis": "The fastest way to storyboard.",
      "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
      "category": "Graphics"
    },
    "fileAssociations": {
      "ext": "storyboarder",
      "name": "Storyboarder file",
      "icon": "build/fileassociation/file"
    },
    "protocols": [
      {
        "name": "Storyboarder",
        "schemes": [
          "storyboarder"
        ]
      }
    ],
    "nsis": {
      "oneClick": false,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true
    },
    "appImage": {}
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/eslint-parser": "^7.29.7",
    "@babel/preset-env": "^7.26.0",
    "@babel/preset-react": "^7.26.0",
    "@babel/register": "^7.26.0",
    "@eslint/js": "^9.0.0",
    "@rollup/plugin-commonjs": "^28.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "concurrently": "^5.3.0",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.5",
    "electron": "33.4.11",
    "electron-builder": "^25.1.8",
    "electron-devtools-installer": "3.1.1",
    "electron-mocha": "^11.0.2",
    "electron-notarize": "^1.1.1",
    "electron-osx-sign": "^0.4.11",
    "eslint": "^9.0.0",
    "esm": "3.2.25",
    "floss": "^2.2.0",
    "globals": "^15.0.0",
    "mocha": "^8.2.0",
    "mock-fs": "4.10.1",
    "nanoid": "^3.3.7",
    "nock": "9.4.2",
    "npm-run-all": "^4.1.5",
    "pidusage": "^2.0.21",
    "vite": "^6.0.0",
    "winston": "^3.3.3"
  },
  "dependencies": {
    "@electron/remote": "^2.0.4",
    "@redux-devtools/extension": "^3.2.2",
    "@thi.ng/geom": "3.1.7",
    "@thi.ng/vectors": "7.4.3",
    "@tweenjs/tween.js": "^18.5.0",
    "@xstate/react": "0.7.1",
    "ag-psd": "^11.1.3",
    "alchemancy": "github:wonderunit/alchemancy#38c4670",
    "archiver": "2.0.3",
    "caf": "7.0.4",
    "chokidar": "3.2.1",
    "classnames": "2.2.6",
    "color-js": "^1.0.4",
    "dayjs": "^1.11.13",
    "eases": "1.0.8",
    "electron-google-analytics": "0.0.16",
    "electron-log": "^5.2.0",
    "electron-redux": "^2.0.0-alpha.9",
    "electron-updater": "^6.3.0",
    "etch": "0.12.8",
    "execa": "0.8.0",
    "ffmpeg-static": "^4.4.1",
    "form-data": "^4.0.0",
    "fraction.js": "4.0.3",
    "fs-extra": "7.0.1",
    "gifencoder": "^1.1.0",
    "gl-vec2": "^1.0.0",
    "i18next": "^19.5.4",
    "i18next-fs-backend": "^1.0.7",
    "i18next-http-backend": "^1.0.16",
    "immer": "1.7.4",
    "jsfeat": "0.0.8",
    "jsonwebtoken": "^9.0.2",
    "layout-bmfont-text": "^1.3.4",
    "liquidmetal": "1.3.0",
    "load-bmfont": "^1.4.0",
    "lodash.debounce": "4.0.8",
    "lodash.isequal": "^4.5.0",
    "lodash.merge": "^4.6.2",
    "lodash.throttle": "4.1.1",
    "node-fetch": "^2.6.1",
    "node-machine-id": "1.1.10",
    "paper": "0.11.5",
    "pdfjs-dist": "^2.13.216",
    "pdfkit": "^0.13.0",
    "plist": "2.1.0",
    "qr-image": "^3.2.0",
    "qrcode-reader": "^1.0.0",
    "quad-indices": "^2.0.1",
    "ramda": "0.25.0",
    "react": "^16.10.1",
    "react-dom": "16.8.6",
    "react-i18next": "^11.7.0",
    "react-pose": "^4.0.10",
    "react-redux": "7.1.0",
    "react-reveal": "^1.2.2",
    "react-select": "^3.0.8",
    "react-three-fiber": "4.0.12",
    "react-use-gesture": "^6.0.14",
    "react-window": "1.5.0",
    "redux": "4.0.1",
    "redux-promise": "0.5.3",
    "redux-thunk": "2.3.0",
    "redux-undo": "1.0.0-beta9-9-7",
    "reselect": "4.0.0",
    "seview": "0.10.0",
    "stats.js": "0.17.0",
    "tether": "1.4.0",
    "tether-drop": "./src/js/vendor/tether-drop",
    "tether-tooltip": "./src/js/vendor/tether-tooltip",
    "three": "^0.115.0",
    "three-bmfont-text": "3.0.1",
    "three-rounded-box": "0.1.1",
    "tmp": "0.0.33",
    "tone": "0.12.0",
    "trash": "7.0.0",
    "wav-encoder": "1.3.0",
    "xml2js": "^0.6.2",
    "xstate": "4.16.2",
    "zustand": "1.0.4"
  },
  "overrides": {
    "@thi.ng/errors": "2.1.3"
  }
}
